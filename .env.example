# ─── Base de données ─────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zma_db
DB_USER=zma_admin
DB_PASSWORD=change_me_in_production

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 64
JWT_SECRET=change_me_in_production
JWT_EXPIRATION_MS=900000

# ─── OAuth2 Google ───────────────────────────────────────────────────────────
# Créer les credentials sur https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── Ports des services ──────────────────────────────────────────────────────
SERVER_PORT_GATEWAY=8080
SERVER_PORT_AUTH=8081
SERVER_PORT_USERS=8082
SERVER_PORT_CATALOG=8083
SERVER_PORT_MEDIA=8084
SERVER_PORT_ENROLLMENT=8085
SERVER_PORT_PAYMENT=8086
SERVER_PORT_COMMUNITY=8087

# ─── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── Services URLs (pour le gateway) ─────────────────────────────────────────
AUTH_SERVICE_URL=http://localhost:8081
CATALOG_SERVICE_URL=http://localhost:8083
MEDIA_SERVICE_URL=http://localhost:8084
ENROLLMENT_SERVICE_URL=http://localhost:8085
PAYMENT_SERVICE_URL=http://localhost:8086
COMMUNITY_SERVICE_URL=http://localhost:8087

# ─── Stockage média (Cloudflare R2 ou AWS S3) ─────────────────────────────────
# STORAGE_TYPE=local   ← par défaut (dev, pas de vrai upload)
# STORAGE_TYPE=r2      ← production
STORAGE_TYPE=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=zma-media
