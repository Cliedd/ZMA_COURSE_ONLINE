{
  "name": "zma-course-online-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test:run",
    "images:encode": "node scripts/encode-images.mjs",
    "lighthouse": "npm run build && lhci autorun",
    "images:placeholders": "node scripts/generate-placeholders.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
